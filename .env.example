# Sanity project ID. Find it in manage.sanity.io under your project's Settings > API,
# or in sanity.config.ts once the Studio is initialized (Task 22).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name to read from/write to. "production" is the default dataset
# created by `sanity init`; see manage.sanity.io > your project > Datasets.
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, pinned as a date string (YYYY-MM-DD) per Sanity's versioning
# scheme. See https://www.sanity.io/docs/api-versioning.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Sanity read token for server-side fetches of unpublished/draft content. Create one
# under manage.sanity.io > your project > API > Tokens (Viewer permission).
SANITY_API_READ_TOKEN=

# Sanity write token used by the seed script and the Studio to create/update content.
# Create one under manage.sanity.io > your project > API > Tokens (Editor permission).
SANITY_API_WRITE_TOKEN=

# Full GraphQL endpoint for /search, copied verbatim from `sanity graphql list`
# after running `sanity graphql deploy`. The version segment (e.g. v2025-09-19) is
# stamped by Sanity at deploy time on its own schedule — it is NOT the same value as
# NEXT_PUBLIC_SANITY_API_VERSION above, and guessing it returns 404. Server-only:
# /search is SSR, so this never reaches the client.
SANITY_GRAPHQL_URL=

# Shared secret checked against incoming Sanity webhook requests to authorize
# on-demand revalidation. Generate any random string and register it as the
# webhook secret in manage.sanity.io > your project > API > Webhooks.
SANITY_REVALIDATE_SECRET=

# Canonical public URL of the deployed site, used for absolute URLs (OpenGraph,
# sitemap, canonical tags). Set to your local origin during development if needed.
NEXT_PUBLIC_SITE_URL=https://lastform.kevinciang.com
